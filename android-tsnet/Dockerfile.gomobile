FROM golang:1.23-bookworm

# Install OpenJDK and dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    openjdk-17-jdk \
    unzip \
    wget \
    git \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Install Android Command Line Tools & NDK
ENV ANDROID_HOME=/opt/android-sdk
ENV ANDROID_SDK_ROOT=/opt/android-sdk
ENV NDK_VERSION=25.2.9519653
ENV ANDROID_NDK_HOME=${ANDROID_HOME}/ndk/${NDK_VERSION}
ENV PATH=${PATH}:${ANDROID_HOME}/cmdline-tools/latest/bin:${ANDROID_HOME}/platform-tools
ENV GOTOOLCHAIN=auto

RUN mkdir -p ${ANDROID_HOME}/cmdline-tools && \
    wget -q https://dl.google.com/android/repository/commandlinetools-linux-11076708_latest.zip -O /tmp/cmdline-tools.zip && \
    unzip -q /tmp/cmdline-tools.zip -d ${ANDROID_HOME}/cmdline-tools && \
    mv ${ANDROID_HOME}/cmdline-tools/cmdline-tools ${ANDROID_HOME}/cmdline-tools/latest && \
    rm /tmp/cmdline-tools.zip

RUN yes | sdkmanager --licenses > /dev/null && \
    sdkmanager --install "platforms;android-34" "build-tools;34.0.0" "ndk;${NDK_VERSION}"

# Install gomobile
RUN go install golang.org/x/mobile/cmd/gomobile@latest && \
    go install golang.org/x/mobile/cmd/gobind@latest && \
    gomobile init

WORKDIR /app
COPY go.mod ./
COPY tools.go ./
COPY tsnetproxy.go ./
RUN go get tailscale.com@v1.78.1 && go mod tidy

RUN mkdir -p /output

CMD ["sh", "-c", "gomobile bind -target=android/arm64 -androidapi=24 -o /output/tsnetproxy.aar . && ls -la /output"]
